# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL credentials - DATABASE_URL is constructed from these
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=crud_factory_registry

# DATABASE_URL constructed from credentials above:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql://postgres:password@localhost:5432/crud_factory_registry

# Neon PostgreSQL (serverless) - uncomment if using Neon instead:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/crud_factory_registry?sslmode=require

# DB_TYPE controls SSL:  "local" (no SSL)  |  "neon" (SSL enabled)
DB_TYPE=local

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be a strong random secret — minimum 32 characters
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_32chars

# ─── Security ─────────────────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt sensitive dbUri values at rest
# Must be EXACTLY 32 characters
ENCRYPTION_KEY=your_32_char_encryption_key_here!!

# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3001

# api-factory-mongo (used to sync per-API policies like CORS)
MONGO_FACTORY_BASE_URL=http://localhost:3000
MONGO_FACTORY_API_VERSION=v1

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
